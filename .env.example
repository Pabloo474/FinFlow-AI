# OpenAI API (required for OpenAI backend, optional for local inference)
OPENAI_API_KEY=your_openai_api_key_here

# Tavily Search API (required for research tool)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional Configuration
# OPENAI_MODEL=gpt-4o
# OPENAI_TEMPERATURE=0.2
# LOG_LEVEL=INFO

# Local Inference (llama.cpp) - uncomment to use local model
# LOCAL_INFERENCE=true
# LOCAL_MODEL_PATH=./models/gemma-4-26B-A4B-it-Q4_K_M.gguf
# LOCAL_N_CTX=32768
# LOCAL_N_THREADS=8